+              defaultLanguage="python"
+              theme="vs-dark"
+              value={scriptCode}
+              onChange={(value) => setScriptCode(value || '')}
+              options={{
+                minimap: { enabled: false },
+                fontSize: 14,
+                wordWrap: 'on',
+                scrollBeyondLastLine: false,
+              }}
+            />
+          </div>
+        </div>
+      )}
+    </div>
   );
 }
